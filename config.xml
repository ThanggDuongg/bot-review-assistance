<?xml version="1.0"?>
<yandex>
  <zookeeper>
    <node index="1">
      <host>zookeeper</host>
      <port>2181</port>
    </node>
  </zookeeper>

  <remote_servers>
    <default>
      <shard>
        <replica>
          <host>clickhouse</host>
          <port>9000</port>
        </replica>
      </shard>
    </default>
  </remote_servers>

  <macros>
    <shard>1</shard>
    <replica>1</replica>
  </macros>
</yandex>
